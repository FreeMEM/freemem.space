    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "Vistas de página que no son robots ni errores. Cuenta a todos, acepten o no las cookies."
